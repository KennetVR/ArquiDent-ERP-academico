# Copiar a .env y completar, o ejecutar scripts/configurar-docker.ps1.
# .env se conserva localmente; Compose no utiliza config/local.ps1.
MYSQL_ROOT_PASSWORD=CAMBIAR-clave-root
MYSQL_PASSWORD=CAMBIAR-clave-aplicacion
HTTP_PORT=8080
FD_DEMO_ENABLED=true
# B + tres letras/digitos. Elegir una serie propia para una base nueva.
FD_DEMO_SERIE=BXYZ
