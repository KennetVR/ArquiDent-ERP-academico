<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ include file="../layout/header.jsp" %><div class="hero"><div class="max-w-7xl mx-auto px-4"><h1>Panel del Paciente</h1><p>Bienvenido, ${sessionScope.usuario.nombre} - Sistema de gestión odontológica</p></div></div><section class="max-w-7xl mx-auto px-4 py-8 w-full"><c:if test="${not empty error}"><div class="alert alert-error"><i class="fas fa-exclamation-triangle mt-0.5"></i><span>${error}</span></div></c:if><c:if test="${not empty mensaje}"><div class="alert alert-ok"><i class="fas fa-check-circle mt-0.5"></i><span>${mensaje}</span></div></c:if><div class="grid grid-2 mb-6"><div class="card"><h2><i class="fas fa-user-injured text-indigo-500"></i>Acciones Rápidas</h2><div class="grid grid-4 mt-3"><a href="${pageContext.request.contextPath}/citas" class="card" style="text-align:center"><div class="w-12 h-12 rounded-full bg-indigo-50 grid place-items-center mx-auto mb-2"><i class="fas fa-calendar-plus text-indigo-500"></i></div><b class="text-sm">Reservar Cita</b><p class="text-xs text-gray-500">Agenda tu atención</p></a><a href="${pageContext.request.contextPath}/citas" class="card" style="text-align:center"><div class="w-12 h-12 rounded-full bg-indigo-50 grid place-items-center mx-auto mb-2"><i class="fas fa-calendar-check text-indigo-500"></i></div><b class="text-sm">Mis Citas</b><p class="text-xs text-gray-500">Ver historial</p></a><a href="${pageContext.request.contextPath}/pacientes" class="card" style="text-align:center"><div class="w-12 h-12 rounded-full bg-indigo-50 grid place-items-center mx-auto mb-2"><i class="fas fa-file-medical text-indigo-500"></i></div><b class="text-sm">Mi Ficha</b><p class="text-xs text-gray-500">Datos y perfil</p></a><a href="${pageContext.request.contextPath}/citas" class="card" style="text-align:center"><div class="w-12 h-12 rounded-full bg-indigo-50 grid place-items-center mx-auto mb-2"><i class="fas fa-id-card text-indigo-500"></i></div><b class="text-sm">Mi Perfil</b><p class="text-xs text-gray-500">Actualizar datos</p></a></div></div><div class="card"><h2><i class="fas fa-clock text-indigo-500"></i>Historial</h2><c:set var="mihistorial" value="${historial}"/><c:choose><c:when test="${empty historial}"><div class="empty"><i class="fas fa-calendar-times"></i><p>No tienes citas registradas aún.</p></div></c:when><c:otherwise><div class="tbl-wrap"><table class="tbl"><thead><tr><th>Fecha</th><th>Servicio</th><th>Odontólogo</th><th>Estado</th><th>Pago</th></tr></thead><tbody><c:forEach var="h" items="${historial}"><tr><td>${h.fecha} ${h.hora}</td><td>${h.servicio}</td><td>${h.odontologo}</td><td><span class="pill ${h.estado=='finalizada'?'pill-green':h.estado=='confirmada'?'pill-blue':h.estado=='cancelada'?'pill-red':'pill-amber'}\">${h.estado}</span></td><td><c:if test="${not empty h.monto}">S/. ${h.monto} <span class="pill ${h.estado_pago=='pagado'?'pill-green':'pill-amber'}\">${h.estado_pago}</span></c:if></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></section><%@ include file="../layout/footer.jsp" %>