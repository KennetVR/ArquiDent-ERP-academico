<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
 version="4.0">
  <display-name>ArquiDent ERP académico</display-name>
  <filter><filter-name>seguridad</filter-name><filter-class>pe.edu.utp.filter.ErpSecurityFilter</filter-class></filter>
  <filter-mapping><filter-name>seguridad</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <servlet><servlet-name>jsp</servlet-name><servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
    <init-param><param-name>development</param-name><param-value>false</param-value></init-param>
    <load-on-startup>3</load-on-startup></servlet>
  <servlet-mapping><servlet-name>jsp</servlet-name><url-pattern>*.jsp</url-pattern></servlet-mapping>
  <servlet><servlet-name>login</servlet-name><servlet-class>pe.edu.utp.controller.LoginController</servlet-class></servlet>
  <servlet><servlet-name>registro</servlet-name><servlet-class>pe.edu.utp.controller.RegistroController</servlet-class></servlet>
  <servlet><servlet-name>logout</servlet-name><servlet-class>pe.edu.utp.controller.LogoutController</servlet-class></servlet>
  <servlet><servlet-name>pacientes</servlet-name><servlet-class>pe.edu.utp.controller.PacientesController</servlet-class></servlet>
  <servlet><servlet-name>recursos</servlet-name><servlet-class>pe.edu.utp.controller.RecursosController</servlet-class></servlet>
  <servlet><servlet-name>citas</servlet-name><servlet-class>pe.edu.utp.controller.CitasController</servlet-class></servlet>
  <servlet><servlet-name>caja</servlet-name><servlet-class>pe.edu.utp.controller.CajaController</servlet-class></servlet>
  <servlet><servlet-name>inicio</servlet-name><servlet-class>pe.edu.utp.controller.InicioController</servlet-class></servlet>
  <servlet><servlet-name>servicios</servlet-name><servlet-class>pe.edu.utp.controller.ServiciosController</servlet-class></servlet>
  <servlet><servlet-name>nosotros</servlet-name><servlet-class>pe.edu.utp.controller.NosotrosController</servlet-class></servlet>
  <servlet><servlet-name>faq</servlet-name><servlet-class>pe.edu.utp.controller.FAQController</servlet-class></servlet>
  <servlet-mapping><servlet-name>login</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>registro</servlet-name><url-pattern>/registro</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>logout</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>pacientes</servlet-name><url-pattern>/pacientes</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>recursos</servlet-name><url-pattern>/recursos</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>citas</servlet-name><url-pattern>/citas</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>caja</servlet-name><url-pattern>/caja</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>inicio</servlet-name><url-pattern>/inicio</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>servicios</servlet-name><url-pattern>/servicios</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>nosotros</servlet-name><url-pattern>/nosotros</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>faq</servlet-name><url-pattern>/faq</url-pattern></servlet-mapping>
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config><http-only>true</http-only></cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  <welcome-file-list><welcome-file>inicio</welcome-file></welcome-file-list>
  <error-page><error-code>500</error-code><location>/WEB-INF/views/erp/error.jsp</location></error-page>
  <error-page><error-code>404</error-code><location>/WEB-INF/views/erp/error.jsp</location></error-page>
  <error-page><error-code>403</error-code><location>/WEB-INF/views/erp/error.jsp</location></error-page>
  <error-page><error-code>503</error-code><location>/WEB-INF/views/erp/error.jsp</location></error-page>
  <mime-mapping><extension>css</extension><mime-type>text/css</mime-type></mime-mapping>
  <mime-mapping><extension>png</extension><mime-type>image/png</mime-type></mime-mapping>
  <listener><listener-class>pe.edu.utp.listener.DatabaseCleanupListener</listener-class></listener>
</web-app>
